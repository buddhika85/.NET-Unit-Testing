<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <ExcludeByFile>**/Program.cs,**/Contracts/Dtos.cs,**/Controllers/*.cs,**/Data/**/*.cs,**/Endpoints/*.cs,**/Exceptions/*.cs,**/Repositories/*.cs</ExcludeByFile> <!-- Globbing filter -->       
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
