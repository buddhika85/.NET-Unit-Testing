{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/MatchMaker.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run tests with coverage",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-File",
                "${workspaceFolder}/test/MatchMaker.UnitTests/scripts/run-tests.ps1",
                "${workspaceFolder}/test/MatchMaker.UnitTests",
            ],            
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}